	(text "TP1 = UPDI; TP2 = voltage sense only; TP3 = GND.\nProgramming: stable RF field power, programmer target\npower disabled. Do not source external power into TP2.\nAn isolated external supply needs V_EH isolation\nnot implemented on this board."
		(at 195.58 105.41 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "9cbf96f1-8c82-5f6d-9423-01f9646cf2a9")
	)
	(text "Ten LED branches match supplied PCB; original locations retained.\nD1, D2, D7, D8, D13 and R3, R4, R9, R10, R15 omitted.\nBefore cold-start testing, set ST25DV EH_MODE=0 through RF configuration.\nMCU firmware must limit LED duty/current. Verify NFC communication under load.\nAntenna resonance, available RF power and programming stability require prototype tests."
		(at 35.56 177.8 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "b4a3e967-401a-5220-acb7-a414ec8185e9")
	)
